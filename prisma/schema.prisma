// prisma/schema.prisma (versão atualizada)
datasource db {
  provider  = "postgresql"
  // Pooled (PgBouncer, transaction mode) — usada em runtime pela aplicação.
  url       = env("DATABASE_URL")
  // Conexão direta (sem pooler) — usada só por comandos de schema/migration
  // (migrate deploy/dev, db push). Advisory locks do Prisma Migrate exigem
  // sessão estável, que uma conexão pooled em modo transação não garante —
  // sem isso, uma migration pode ficar travada esperando um lock preso numa
  // conexão reaproveitada pelo pooler para outra query qualquer.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Profile {
  id                   String   @id @default(uuid())
  userId               String   @unique
  email                String
  subscriptionTier     String?
  subscriptionActive   Boolean  @default(false)
  stripeSubscriptionId String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  // Dados físicos
  height        Float? // altura em CENTÍMETROS (ex.: 175). Antes de 2026-08-23 era metros — ver migration de conversão.
  startWeight   Float? // peso inicial (kg)
  targetWeight  Float? // peso meta (kg)
  currentWeight Float? // peso atual (kg)
  dietType      String? // tipo de dieta atual
  cookingLevel  String? // nível na cozinha

  // Usados para personalizar o cálculo calórico (nunca expostos publicamente)
  birthDate     DateTime? // data de nascimento — idade é sempre calculada dinamicamente
  activityLevel String? // sedentary | light | moderate | active (ver lib/profile/options.ts)

  // Dica diária da IA (cacheada para não chamar o modelo a cada carregamento)
  dailyTip     String?
  dailyTipDate DateTime?

  // Hidratação — meta pessoal configurável (ver lib/hydration). 2500ml é só
  // um fallback inicial, nunca uma recomendação médica personalizada.
  dailyWaterGoalMl Int @default(2500)

  // Papel na comunidade (moderação)
  role ProfileRole @default(USER)

  // Onboarding
  onboardingCompletedAt DateTime?
  onboardingVersion     Int       @default(0)

  // Relações
  mealPlans      MealPlan[]
  shoppingLists  ShoppingList[]
  weightLogs     WeightLog[]
  preferences    UserPreferences?
  progressPhotos ProgressPhoto[]
  premiumGrants  PremiumGrant[]
  activityLogs   ActivityLog[]

  // Relações — Comunidade / Gamificação
  socialProfile           SocialProfile?
  gamification            UserGamification?
  xpEvents                XpEvent[]
  dailyActivities         DailyActivity[]
  achievements            UserAchievement[]
  ownedGroups             CommunityGroup[]
  groupMemberships        GroupMember[]
  createdChallenges       Challenge[]
  challengeParticipations ChallengeParticipant[]
  communityPosts          CommunityPost[]
  communityComments       CommunityComment[]
  communityReactions      CommunityReaction[]
  contentReports          ContentReport[]
  notifications           Notification[]
  hashtagFollows          UserHashtagFollow[]
  postFeedFeedback        PostFeedFeedback[]
  activityGoals           ActivityGoal[]
  activityInsights        ActivityInsight[]
  waterLogs               WaterLog[]

  // Relações — Integrações externas (Connected Apps)
  connectedApps          ConnectedApp[]
  externalActivityCaches ExternalActivityCache[]
}

// 🔥 NOVO MODELO PARA DETALHES NUTRICIONAIS
model NutritionalInfo {
  id        String   @id @default(uuid())
  mealId    String   @unique
  meal      Meal     @relation(fields: [mealId], references: [id], onDelete: Cascade)
  calories  Int
  protein   Float // em gramas
  carbs     Float // em gramas
  fat       Float // em gramas
  fiber     Float? // em gramas
  sugar     Float? // em gramas
  sodium    Float? // em mg
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 🔥 NOVO MODELO PARA REFEIÇÕES DETALHADAS
model Meal {
  id          String  @id @default(uuid())
  dayPlanId   String
  dayPlan     DayPlan @relation(fields: [dayPlanId], references: [id], onDelete: Cascade)
  type        String // "breakfast", "lunch", "dinner", "snack"
  name        String
  description String?
  prepTime    Int? // minutos
  difficulty  String? // "Fácil", "Médio", "Difícil"
  servings    Int?    @default(1)

  // Feedback
  rating     Int? // 1-5
  completed  Boolean @default(false)
  isFavorite Boolean @default(false)
  userNotes  String?

  // Relações
  nutritionalInfo NutritionalInfo?
  ingredients     Ingredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 🔥 NOVO MODELO PARA INGREDIENTES
model Ingredient {
  id     String  @id @default(uuid())
  mealId String
  meal   Meal    @relation(fields: [mealId], references: [id], onDelete: Cascade)
  name   String
  amount Float
  unit   String // "g", "kg", "ml", "xícara", "colher"
  notes  String? // "picado", "cozido", etc

  createdAt DateTime @default(now())
}

model MealPlan {
  id         String   @id @default(uuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  name       String? // "Meu plano de verão"
  dietType   String
  calories   Int
  allergies  String?
  cuisine    String?
  snacks     Boolean
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  isTemplate Boolean  @default(false)
  favorite   Boolean  @default(false) // Para marcar como favorito

  // 🔥 ADICIONAR CAMPO PARA SALVAR CONTEXTO DO USUÁRIO
  userContext Json? // Salva os dados do usuário no momento da criação

  // Relações
  days          DayPlan[]
  shoppingLists ShoppingList[]
  sharedPlans   SharedPlan[]

  @@index([userId])
  @@index([createdAt])
}

model DayPlan {
  id         String   @id @default(uuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  day        String // Monday, Tuesday, etc (armazenar em inglês)

  // 🔥 SUBSTITUIR STRINGS POR RELAÇÕES
  breakfast String? // REMOVER - vamos usar o modelo Meal
  lunch     String? // REMOVER
  dinner    String? // REMOVER
  snacks    String? // REMOVER

  // 🔥 ADICIONAR RELAÇÕES
  meals Meal[] // Todas as refeições do dia

  // Feedback do dia
  dayRating   Int? // 1-5
  dayFeedback String? // Comentário sobre o dia

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mealPlanId, day])
  @@index([mealPlanId])
}

model ShoppingList {
  id         String   @id @default(uuid())
  userId     String
  user       Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  items      Json // Lista de itens agrupados por categoria
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model WeightLog {
  id     String   @id @default(uuid())
  userId String
  user   Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  weight Float // Peso em kg
  date   DateTime @default(now())
  notes  String?

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// Fotos de progresso (Antes & Depois). Dado privado — nunca exposto pela
// Comunidade. Adicionar uma foto NÃO cria WeightLog automaticamente; o peso
// aqui é só um snapshot associado à foto.
model ProgressPhoto {
  id      String  @id @default(uuid())
  userId  String
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  imageUrl String // caminho/URL do arquivo — nunca base64 no banco
  weight   Float? // snapshot opcional do peso no momento da foto
  takenAt  DateTime @default(now())
  notes    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, takenAt])
}

// Registro de atividade física — privado por padrão (só some da esfera
// privada quando o usuário compartilha explicitamente via CommunityPost).
// IMPORTANTE: ActivityLog é sempre um registro GAMIFICADO (gera XP/streak/
// progresso de desafio — ver lib/community/gamification.ts) e só existe para
// `source = MANUAL` nesta implementação. Atividades sincronizadas de
// provedores externos (Strava etc.) NUNCA viram ActivityLog — elas ficam em
// ExternalActivityCache, que é puramente privado e nunca alimenta
// gamificação (ver lib/integrations/provider-policy.ts). `source`/
// `externalId` seguem preparados no schema para uma eventual futura política
// que permita a um provedor "promover" uma atividade a ActivityLog completo
// mediante confirmação explícita do usuário — não implementado agora.
model ActivityLog {
  id      String  @id @default(uuid())
  userId  String
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  activityType       String // ver lib/activity/options.ts (WALKING, RUNNING, ... OTHER)
  customActivityName String? // só quando activityType = OTHER
  durationMin        Int
  distanceKm         Float?
  intensity          String? // LIGHT | MODERATE | HIGH — ver lib/activity/options.ts
  notes              String?

  source     ActivitySource @default(MANUAL)
  externalId String?

  performedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sharedPost CommunityPost?

  @@unique([source, externalId])
  @@index([userId, performedAt])
}

enum ActivitySource {
  MANUAL
  STRAVA
  GARMIN
  HEALTH_CONNECT
  APPLE_HEALTH
  SAMSUNG_HEALTH
  FITBIT
  OTHER
}

// ══════════════════════════════════════════════════════════════════════════
// BETA / ACESSO PREMIUM CONCEDIDO (não-Stripe)
// ══════════════════════════════════════════════════════════════════════════

enum PremiumGrantSource {
  BETA_CODE
  PROMO_CODE
  ADMIN
}

// Concessão de acesso Premium fora do Stripe (hoje só códigos Beta). A
// assinatura paga (Profile.subscriptionActive) permanece totalmente
// independente — ver lib/premium/access.ts para a resolução combinada.
model PremiumGrant {
  id      String  @id @default(uuid())
  userId  String
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  source PremiumGrantSource

  startsAt  DateTime
  expiresAt DateTime
  revokedAt DateTime?

  // Auditoria de revogação administrativa (ver lib/admin/premium.ts). Nunca
  // preenchidos fora do fluxo de revogação do painel admin.
  revokedByUserId String?
  revokedReason   String?

  // Referência à origem (ex.: BetaCode.id). Único para garantir que uma
  // mesma origem (um código Beta) nunca gere mais de um grant.
  sourceRefId String? @unique

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([revokedAt])
}

// Código Beta de uso único. Nunca armazena o código em texto puro — apenas
// o hash SHA-256 (ver lib/beta/codes.ts). redeemedByUserId é único: garante
// no banco que um usuário não consiga resgatar dois códigos Beta.
model BetaCode {
  id String @id @default(uuid())

  codeHash String  @unique
  codeHint String? // últimos caracteres, só para conferência humana — nunca o código completo

  durationDays Int @default(30)

  isActive Boolean @default(true)

  redeemUntil DateTime?

  redeemedByUserId String?   @unique
  redeemedAt       DateTime?

  // Agrupamento do lote gerado no painel admin (ver lib/admin/beta.ts) e
  // quem o gerou. Nulos para códigos criados antes do painel admin existir.
  batchId         String?
  createdByUserId String?

  // Desativação administrativa (ver lib/admin/beta.ts). isActive continua
  // sendo o campo consultado no resgate (lib/beta/redeem.ts) — estes dois
  // campos só adicionam "quem" e "quando" para auditoria/exibição no admin.
  disabledAt       DateTime?
  disabledByUserId String?

  createdAt DateTime @default(now())

  @@index([isActive])
  @@index([batchId])
}

// Ledger administrativo genérico — mesmo model já especificado em
// SMARTPLATE_PARCEIROS_ACADEMIAS_IMPLEMENTACAO.md (seção 76) para que ações
// futuras de academias/parceiros usem esta MESMA tabela (tenantType/tenantId),
// em vez de uma segunda fonte de verdade de auditoria. Ações do admin global
// desta implementação deixam tenantType/tenantId nulos. action e targetType
// são strings livres (documentadas em código, não em enum) para não travar
// a evolução de novas ações administrativas. Nunca guardar código Beta
// completo, token, senha ou outro segredo em metadata.
model AuditLog {
  id String @id @default(uuid())

  actorUserId String?

  tenantType String?
  tenantId   String?

  action String

  targetType String
  targetId   String?

  metadata Json?

  ipHash    String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([tenantType, tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

model UserPreferences {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  allergies       String[] // Restrições/alergias alimentares (array)
  dislikedFoods   String[] // Alimentos que não gosta (array)
  preferredFoods  String[] // Alimentos/culinárias que prefere (array)
  maxPrepTime     Int? // Minutos máximos de preparo
  budgetLevel     String? // "low", "medium", "high"
  dietGoal        String? // "perder peso", "ganhar massa", "manter"
  additionalNotes String? // Observações livres do usuário para a geração do plano
  updatedAt       DateTime @updatedAt
}

model SharedPlan {
  id         String    @id @default(uuid())
  mealPlanId String
  mealPlan   MealPlan  @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)
  shareToken String    @unique @default(uuid())
  expiresAt  DateTime? // Se null, não expira
  createdAt  DateTime  @default(now())
  views      Int       @default(0)

  @@index([shareToken])
}

// ══════════════════════════════════════════════════════════════════════════
// COMUNIDADE E GAMIFICAÇÃO
// ══════════════════════════════════════════════════════════════════════════

enum ProfileRole {
  USER
  MODERATOR
  ADMIN
}

enum GroupMemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum ChallengeScope {
  GLOBAL
  GROUP
}

enum ChallengeMetric {
  ACTIVE_DAYS
  MEAL_COMPLETIONS
  STREAK_DAYS
  // Métricas de atividade física — ver lib/community/challenge-metrics.ts
  // para o cálculo central de cada uma (sempre recalculado no servidor a
  // partir de ActivityLog/DailyActivity, nunca aceito do cliente).
  ACTIVITY_COUNT
  ACTIVITY_MINUTES
  WALKING_DAYS
  RUNNING_DAYS
  CYCLING_DAYS
  STRENGTH_DAYS
  // Dia com refeição concluída E atividade elegível no mesmo dia local
  // (mesma regra da conquista BALANCED_ROUTINE_WEEK/CONSISTENT_ROUTINE).
  BALANCED_DAYS
}

enum PostType {
  TEXT
  ACHIEVEMENT
  STREAK
  CHALLENGE
  PLAN_SHARE
  ACTIVITY
  // Conteúdo compartilhado pelo próprio usuário de outro app (link/imagem/
  // legenda fornecidos por ele) — nunca dado obtido via API de integração.
  // Ver seção "Compartilhamento externo genérico" do README.
  EXTERNAL_SHARE
  // Antes & Depois compartilhado deliberadamente (seção 22) — a imagem é
  // sempre uma CÓPIA do blob privado de ProgressPhoto, nunca uma referência
  // viva (ver lib/storage/blob.ts::copyPrivateImage).
  PROGRESS_SHARE
}

enum ReactionType {
  LIKE
  FIRE
  CLAP
  STRONG
}

enum ReportTargetType {
  POST
  COMMENT
  USER
  AI_CONTENT
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  SEXUAL
  DANGEROUS_HEALTH_ADVICE
  MISINFORMATION
  OTHER
}

enum ReportStatus {
  PENDING
  RESOLVED
  DISMISSED
}

// Perfil público/social do usuário. Nunca deve expor dados de Profile como
// peso, altura, objetivo, e-mail ou dados de assinatura.
model SocialProfile {
  id                String  @id @default(uuid())
  userId            String  @unique
  profile           Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)
  username          String  @unique
  displayName       String
  // Foto enviada pelo usuário no SmartPlate (aponta pro storage do Clerk,
  // que já hospeda o upload via user.setProfileImage) — nunca sobrescrita
  // por sincronização automática do provedor OAuth.
  customAvatarUrl   String?
  // Foto do provedor OAuth (ex.: Google), capturada de externalAccounts[].
  // Usada como fallback quando não há foto personalizada, ou quando ela é
  // removida. Nunca confundir com user.imageUrl do Clerk, que já reflete a
  // foto personalizada depois de um upload.
  providerAvatarUrl String?
  bio               String?
  timezone          String  @default("UTC")
  isDiscoverable    Boolean @default(true)
  showStreak        Boolean @default(true)
  showXp            Boolean @default(true)
  showAchievements  Boolean @default(true)

  // Preferências de notificação por categoria (ver lib/community/notify.ts).
  // Só as categorias com gatilho real hoje (notifySocial, notifyActivities)
  // filtram alguma coisa de fato — as demais existem para a tela de
  // configuração já ficar completa, preparadas para gatilhos futuros.
  notifySocial     Boolean @default(true)
  notifyMeals      Boolean @default(true)
  notifyActivities Boolean @default(true)
  notifyChallenges Boolean @default(true)
  notifyStreak     Boolean @default(true)
  notifyProgress   Boolean @default(true)
  notifyReminders  Boolean @default(true)

  termsAcceptedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([username])
}

// Estado agregado de gamificação do usuário (totais e streak atuais).
// A fonte da verdade para XP histórico/ranking é XpEvent, não totalXp.
model UserGamification {
  id                String    @id @default(uuid())
  userId            String    @unique
  profile           Profile   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  totalXp           Int       @default(0)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  lastQualifiedDate DateTime? @db.Date
  level             Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Histórico imutável de eventos de XP. idempotencyKey impede XP duplicado
// (ex.: marcar/desmarcar a mesma refeição repetidamente).
model XpEvent {
  id             String   @id @default(uuid())
  userId         String
  profile        Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  eventType      String
  points         Int
  idempotencyKey String   @unique
  referenceType  String?
  referenceId    String?
  createdAt      DateTime @default(now())

  @@index([userId, createdAt])
}

// Registro diário real de atividade (data local do usuário, não UTC puro).
// Usado para calcular streak — não usar DayPlan.day (nome do dia da semana).
model DailyActivity {
  id                 String   @id @default(uuid())
  userId             String
  profile            Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  date               DateTime @db.Date
  qualifyingActions  Int      @default(0)
  xpEarned           Int      @default(0)
  qualifiesForStreak Boolean  @default(false)

  // Sinalizadores por tipo de ação — permitem detectar combinações no mesmo
  // dia (ex.: refeição + atividade) sem precisar reprocessar XpEvent/ActivityLog.
  mealCompleted             Boolean @default(false)
  physicalActivityCompleted Boolean @default(false)
  // XP ganho especificamente por ActivityLog no dia — usado para aplicar o
  // teto diário de XP de atividade física, separado do xpEarned geral.
  activityXpEarned          Int     @default(0)
  // Meta diária de água atingida NAQUELE dia (goal vigente na época, não
  // recalculado retroativamente se a meta mudar depois) — usado por
  // WATER_GOAL_*_DAYS/BALANCED_WEEK. Nunca alimenta qualifiesForStreak (o
  // streak geral do SmartPlate não muda com esta tarefa).
  waterGoalCompleted        Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
}

model UserAchievement {
  id              String   @id @default(uuid())
  userId          String
  profile         Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  achievementCode String
  unlockedAt      DateTime @default(now())

  @@unique([userId, achievementCode])
  @@index([userId])
}

// Amizade com par normalizado (userAId = menor id, userBId = maior id) para
// impedir duplicidade A→B / B→A. requesterId identifica quem solicitou.
// Recusar/cancelar/desfazer amizade remove a linha.
model Friendship {
  id          String           @id @default(uuid())
  userAId     String
  userBId     String
  requesterId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([requesterId])
}

// Bloqueio direcional (A bloqueia B não implica B bloqueia A).
model CommunityBlock {
  id            String   @id @default(uuid())
  blockerUserId String
  blockedUserId String
  createdAt     DateTime @default(now())

  @@unique([blockerUserId, blockedUserId])
  @@index([blockerUserId])
  @@index([blockedUserId])
}

// Silenciar um tipo de post no feed (ex.: nunca mostrar ACHIEVEMENT) — mais
// leve que bloqueio, não afeta amizade/visibilidade de perfil. postType é
// String (não FK pro enum PostType) pelo mesmo motivo de XpEvent.eventType:
// nunca travar numa migration só para permitir silenciar um tipo novo.
model UserContentMute {
  id        String   @id @default(uuid())
  userId    String
  postType  String
  createdAt DateTime @default(now())

  @@unique([userId, postType])
  @@index([userId])
}

// Ocultar as publicações de um usuário específico do próprio feed, sem
// bloquear (amizade/comentários/reações continuam funcionando normalmente
// nos dois sentidos — só o feed deixa de mostrar). String pura (sem relation
// nomeada), mesmo padrão de CommunityBlock acima.
model UserFeedMute {
  id          String   @id @default(uuid())
  muterUserId String
  mutedUserId String
  createdAt   DateTime @default(now())

  @@unique([muterUserId, mutedUserId])
  @@index([muterUserId])
  @@index([mutedUserId])
}

model CommunityGroup {
  id          String   @id @default(uuid())
  name        String
  description String?
  ownerUserId String
  owner       Profile  @relation(fields: [ownerUserId], references: [userId], onDelete: Cascade)
  inviteCode  String   @unique @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members    GroupMember[]
  posts      CommunityPost[]
  challenges Challenge[]
  invites    GroupInvite[]

  @@index([ownerUserId])
}

model GroupMember {
  id       String          @id @default(uuid())
  groupId  String
  group    CommunityGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId   String
  profile  Profile         @relation(fields: [userId], references: [userId], onDelete: Cascade)
  role     GroupMemberRole @default(MEMBER)
  joinedAt DateTime        @default(now())

  @@unique([groupId, userId])
  @@index([userId])
}

enum GroupInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

// Convite direcionado a um usuário específico (diferente do inviteCode
// compartilhável de CommunityGroup, que qualquer um com o link pode usar).
// invitedUserId/invitedByUserId ficam String puros (sem relation nomeada),
// mesmo padrão de Friendship/CommunityBlock — dois FKs pro mesmo Profile só
// pra navegação de objeto não valem a duplicação de relations nomeadas.
model GroupInvite {
  id              String            @id @default(uuid())
  groupId         String
  group           CommunityGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  invitedUserId   String
  invitedByUserId String
  status          GroupInviteStatus @default(PENDING)
  createdAt       DateTime          @default(now())
  respondedAt     DateTime?

  @@unique([groupId, invitedUserId, status])
  @@index([invitedUserId])
}

model Challenge {
  id               String          @id @default(uuid())
  creatorUserId    String?
  creator          Profile?        @relation(fields: [creatorUserId], references: [userId], onDelete: SetNull)
  groupId          String?
  group            CommunityGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scope            ChallengeScope
  title            String
  description      String?
  metric           ChallengeMetric
  target           Int
  // Meta "editorial" opcional do grupo — quando definida pelo criador (só
  // faz sentido para scope GROUP), o ranking usa este valor como o objetivo
  // coletivo em vez do derivado automaticamente (target * nº de
  // participantes). Nunca afeta a recompensa individual, que continua por
  // ChallengeParticipant.progress/target normalmente.
  collectiveTarget Int?
  rewardXp         Int             @default(0)
  startsAt         DateTime
  endsAt           DateTime
  createdAt        DateTime        @default(now())

  participants ChallengeParticipant[]

  @@index([scope])
  @@index([groupId])
  @@index([startsAt, endsAt])
}

model ChallengeParticipant {
  id          String    @id @default(uuid())
  challengeId String
  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  userId      String
  profile     Profile   @relation(fields: [userId], references: [userId], onDelete: Cascade)
  progress    Int       @default(0)
  joinedAt    DateTime  @default(now())
  completedAt DateTime?

  @@unique([challengeId, userId])
  @@index([userId])
}

// Se groupId = null, pertence à comunidade geral; senão, visível só a membros.
model CommunityPost {
  id           String          @id @default(uuid())
  authorUserId String
  author       Profile         @relation(fields: [authorUserId], references: [userId], onDelete: Cascade)
  groupId      String?
  group        CommunityGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  type         PostType
  text         String?
  metadata     Json?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  deletedAt    DateTime?
  hiddenAt     DateTime?

  // Post ACTIVITY referencia o ActivityLog de origem (só para bookkeeping —
  // ex.: saber se já foi compartilhado). O conteúdo exibido é sempre o
  // snapshot em `metadata`, nunca um join ao vivo (ActivityLog pode ser
  // editado/apagado depois; o post mantém seu registro histórico).
  activityLogId String?      @unique
  activityLog   ActivityLog? @relation(fields: [activityLogId], references: [id], onDelete: SetNull)

  reactions CommunityReaction[]
  comments  CommunityComment[]
  hashtags  PostHashtag[]
  feedback  PostFeedFeedback[]

  @@index([createdAt])
  @@index([groupId, createdAt])
  @@index([authorUserId])
}

model CommunityReaction {
  id        String        @id @default(uuid())
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  profile   Profile       @relation(fields: [userId], references: [userId], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime      @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
}

model CommunityComment {
  id           String        @id @default(uuid())
  postId       String
  post         CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorUserId String
  author       Profile       @relation(fields: [authorUserId], references: [userId], onDelete: Cascade)
  text         String
  createdAt    DateTime      @default(now())
  deletedAt    DateTime?

  @@index([postId, createdAt])
}

model ContentReport {
  id             String           @id @default(uuid())
  reporterUserId String
  reporter       Profile          @relation(fields: [reporterUserId], references: [userId], onDelete: Cascade)
  targetType     ReportTargetType
  targetId       String
  reason         ReportReason
  details        String?
  status         ReportStatus     @default(PENDING)
  createdAt      DateTime         @default(now())
  reviewedAt     DateTime?

  @@index([status])
  @@index([targetType, targetId])
}

// ══════════════════════════════════════════════════════════════════════════
// METAS E INSIGHTS DE ATIVIDADE FÍSICA
// ══════════════════════════════════════════════════════════════════════════

enum ActivityGoalMetric {
  ACTIVE_DAYS
  ACTIVITY_MINUTES
  ACTIVITY_COUNT
}

// Meta semanal pessoal, escolhida pelo próprio usuário — nunca um valor
// "ideal" definido pelo sistema (ver lib/activity/goals.ts). Um usuário pode
// ter as três métricas simultaneamente, cada uma com seu próprio target
// (por isso model separado, não campos soltos em Profile). `isActive` permite
// desativar sem perder o histórico de eventos idempotentes já concedidos
// (XpEvent "activity-goal:{goalId}:{semana}").
model ActivityGoal {
  id      String  @id @default(uuid())
  userId  String
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  metric   ActivityGoalMetric
  target   Int
  isActive Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, metric])
  @@index([userId, isActive])
}

// Cache dos insights privados de atividade (determinísticos + IA) por
// usuário/período — nunca gerado a cada render (ver lib/activity/insights.ts).
// `dataHash` evita regenerar via IA quando os dados agregados não mudaram.
// Nunca visível na Comunidade — sempre privado ao próprio usuário.
model ActivityInsight {
  id      String  @id @default(uuid())
  userId  String
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  periodStart DateTime
  periodEnd   DateTime
  content     Json
  dataHash    String

  createdAt DateTime @default(now())

  @@index([userId, periodStart])
}

// Registro individual de consumo de água (funcionalidade 39). Meta diária
// fica em Profile.dailyWaterGoalMl — ver lib/hydration/*.
model WaterLog {
  id      String  @id @default(uuid())
  userId  String
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  amountMl Int
  loggedAt DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([userId, loggedAt])
}

// ══════════════════════════════════════════════════════════════════════════
// HASHTAGS (interesses/descoberta) E SINAIS DE FEED
// ══════════════════════════════════════════════════════════════════════════

// name/slug sempre iguais e já normalizados (lowercase, sem #, trim — ver
// lib/community/hashtags.ts). Mantidos como dois campos por clareza de
// propósito (name = exibição, slug = chave de URL), não porque divergem hoje.
model Hashtag {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  posts     PostHashtag[]
  followers UserHashtagFollow[]

  @@index([name])
}

model PostHashtag {
  postId    String
  hashtagId String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  hashtag   Hashtag       @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([postId, hashtagId])
  @@index([hashtagId])
}

// Interesse EXPLÍCITO do usuário (nunca inferido por ele apenas usar a
// hashtag num post — ver lib/community/hashtags.ts). Sinal de entrada do
// ranking do Feed Para Você (ver lib/community/feed-ranking.ts).
model UserHashtagFollow {
  userId    String
  hashtagId String
  profile   Profile  @relation(fields: [userId], references: [userId], onDelete: Cascade)
  hashtag   Hashtag  @relation(fields: [hashtagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, hashtagId])
  @@index([userId])
  @@index([hashtagId])
}

enum FeedFeedbackType {
  NOT_INTERESTED
}

// Feedback de recomendação (distinto de denúncia/moderação — ver
// ContentReport/hiddenAt). Só afeta o Feed Para Você do próprio usuário.
model PostFeedFeedback {
  id        String           @id @default(uuid())
  userId    String
  postId    String
  profile   Profile          @relation(fields: [userId], references: [userId], onDelete: Cascade)
  post      CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  type      FeedFeedbackType
  createdAt DateTime         @default(now())

  @@unique([userId, postId, type])
  @@index([userId])
  @@index([postId])
}

// ══════════════════════════════════════════════════════════════════════════
// NOTIFICAÇÕES
// ══════════════════════════════════════════════════════════════════════════

// Notificação mínima real e persistida (ex.: desafio concluído). `type` fica
// String (não enum) de propósito — assim como XpEvent.eventType, é uma lista
// que deve crescer sem exigir migration a cada novo tipo. `data` carrega
// referências (ex.: challengeId) para navegação, nunca dado privado.
model Notification {
  id      String  @id @default(uuid())
  userId  String
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  type  String
  title String
  body  String
  data  Json?

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ══════════════════════════════════════════════════════════════════════════
// INTEGRAÇÕES EXTERNAS (CONNECTED APPS)
// ══════════════════════════════════════════════════════════════════════════

enum ConnectedAppProvider {
  STRAVA
  GARMIN
  HEALTH_CONNECT
  APPLE_HEALTH
  SAMSUNG_HEALTH
  FITBIT
  OTHER
}

enum ConnectedAppStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

// Uma linha por (usuário, provedor). Tokens NUNCA em texto puro — sempre
// through lib/integrations/token-crypto.ts (AES-256-GCM, chave só em env).
// Ver lib/integrations/provider-policy.ts para o que cada provider pode ou
// não fazer (nunca checar `provider === "STRAVA"` espalhado pelo código).
model ConnectedApp {
  id      String  @id @default(uuid())
  userId  String
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  provider ConnectedAppProvider
  status   ConnectedAppStatus   @default(CONNECTED)

  scopes         String[]
  providerUserId String? // ex.: athlete id do Strava — nunca exposto a outros usuários

  accessTokenEncrypted  String?   @db.Text
  refreshTokenEncrypted String?   @db.Text
  expiresAt             DateTime?

  connectedAt    DateTime  @default(now())
  lastSyncedAt   DateTime?
  disconnectedAt DateTime?
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, provider])
  @@index([userId])
}

// Cache PRIVADO e TRANSITÓRIO de atividades de provedores externos.
// Propositalmente separado de ActivityLog: nunca gera XpEvent, nunca conta
// em streak/desafio/ranking, nunca vira post automaticamente — ver
// lib/integrations/provider-policy.ts (allowPersistentActivity/
// allowPublicGamification = false para todo provider externo). Expira em
// no máximo `EXTERNAL_ACTIVITY_CACHE_MAX_DAYS` (ver lib/integrations/
// provider-policy.ts) e é purgado por purgeExpiredExternalActivityCache().
model ExternalActivityCache {
  id      String  @id @default(uuid())
  userId  String
  profile Profile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  provider   ConnectedAppProvider
  externalId String

  activityType String // mapeado para lib/activity/options.ts na exibição
  name         String?
  durationMin  Int
  distanceKm   Float?
  performedAt  DateTime

  cachedAt  DateTime @default(now())
  expiresAt DateTime

  @@unique([userId, provider, externalId])
  @@index([userId, provider])
  @@index([expiresAt])
}
